# ---------------------------------------------------------------------------
# FareLens configuration
# Copy to .env and adjust. Everything here has a sensible default; the only
# value you should change before exposing the service publicly is
# APP_SECRET_KEY (and the default admin password from the UI).
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=FareLens
APP_ENV=production                 # production | development
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000

# Secret used to sign admin sessions and to encrypt stored credentials
# (LLM API keys, external datastore DSNs). If empty, a key is generated on
# first start and persisted under APP_DATA_DIR/secret.key.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Writable directory for local state (generated secret, datastore overrides).
# In Docker this is the /data volume.
APP_DATA_DIR=./data

# --- Bundled datastores (docker compose) -------------------------------------
# These are the connections to the Postgres/Redis containers that ship with
# docker-compose.yml. You can point the app at your own Postgres/Redis from
# the admin UI (Settings -> Data stores); that override is stored in
# APP_DATA_DIR and takes precedence over the values below.
DATABASE_URL=postgresql://farelens:farelens@postgres:5432/farelens
REDIS_URL=redis://redis:6379/0

# Credentials used by the bundled Postgres container itself.
POSTGRES_USER=farelens
POSTGRES_PASSWORD=farelens
POSTGRES_DB=farelens

# --- Admin UI ---------------------------------------------------------------
# A default admin user is created on first start. Change the password from the
# UI right away; the UI shows a warning until you do.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin
ADMIN_SESSION_HOURS=12

# Comma-separated list of allowed browser origins for the API. "*" allows all.
CORS_ALLOW_ORIGINS=*

# --- Limits & caching -------------------------------------------------------
MAX_FARE_RULES_CHARS=60000        # max characters of fare-rules text per request / segment
MAX_HISTORY_MESSAGES=20           # chat history turns forwarded to the model
SUMMARY_CACHE_TTL_SECONDS=2592000 # Redis TTL for generated summaries (30 days)
SUMMARY_CACHE_NAMESPACE=v1        # bump to invalidate all cached summaries after prompt changes
CONVERSATION_TTL_SECONDS=3600     # how long chat context (segments) is retained per convo_id
LLM_TIMEOUT_SECONDS=90

# Rate limit for /api/v1 (per API key, sliding window)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
